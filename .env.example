# Owner/superuser connection, used only by `npm run migrate`. Never give this to the API.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# Restricted role the API connects as. RLS only works because this role is not the table owner.
DATABASE_URL=postgres://app_user:app_pw@localhost:5432/app
# Optional: replaces the dev password from 001_init.sql when migrations run.
APP_USER_PASSWORD=
# Signs tenant tokens. 16+ characters. Replace this placeholder.
TOKEN_SECRET=replace-with-a-long-random-secret
PORT=3000
